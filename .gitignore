# ============================================================

# SB Records Management System - Git Ignore

# ============================================================

# Local environment

.env
.env.*
!.env.example

# XAMPP / local configuration

xampp/
*.log

# PHP generated files

*.cache

# IDE / Editor files

.vscode/
.idea/

# Operating system files

.DS_Store
Thumbs.db
desktop.ini

# Temporary files

*.tmp
*.temp
*.bak
*.swp
*.swo

# Local database backups

*.bak.sql
*.backup.sql
*_backup.sql

# Temporary scanned documents

# Keep the folder structure but do not upload private documents.

scanned_docs/*
!scanned_docs/.gitkeep

# Local test files

test/
tests/local/

# PHP error/debug output

error_log
php_errors.log
debug.log
